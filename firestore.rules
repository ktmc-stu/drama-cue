rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Company lock: swap the body for
    //   request.auth != null && request.auth.uid in ['UID_1','UID_2']
    // to restrict the desk to named operator accounts.
    function crew() { return signedIn(); }

    match /shows/{showId} {
      allow read: if crew();
      allow create: if crew()
                    && request.resource.data.name is string
                    && request.resource.data.cues is list
                    && request.resource.data.cues.size() <= 800;
      allow update, delete: if crew();
    }

    match /userSettings/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
